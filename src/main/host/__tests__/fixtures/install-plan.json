      "activate": "chmod 700 \"$HOME/.tessel-server/host/bin/.tessel-host-0.1.1-aarch64.0123456789abcdef.part\" && mv -f \"$HOME/.tessel-server/host/bin/.tessel-host-0.1.1-aarch64.0123456789abcdef.part\" \"$HOME/.tessel-server/host/bin/tessel-host-0.1.1-aarch64\" && \"$HOME/.tessel-server/host/bin/tessel-host-0.1.1-aarch64\" version",
