# electron-vite 5 conservatively caps its Vite peer at ^7, but we run Vite 8
# deliberately: Vite 8 dropped its direct esbuild dependency (moved to Rolldown),
# which clears the esbuild dev-server advisories that Vite <=7 still carries.
# electron-vite works fine with Vite 8 in practice (build + tests + app boot all
# pass); this flag stops npm 10 from treating that one conservative peer range as
# a hard install error. Remove it once electron-vite declares Vite 8 support.
legacy-peer-deps=true
