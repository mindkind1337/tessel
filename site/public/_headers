# Cloudflare Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
# The site runs only its own scripts, and frames only the demo. The log-in pages share this
# address, with their own policy: nothing else may run here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-src https://demo.tesselcode.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
